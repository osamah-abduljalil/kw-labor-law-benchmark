# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your API credentials:
#   cp .env.example .env
# ==============================================================================

# OpenAI API Key (for GPT-4o, GPT-4, etc.)
# https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (for LLaMA 3.1, Qwen 2.5, Mistral, etc.)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# DeepSeek API Key (OpenAI-compatible client)
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key
# https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Hugging Face Access Token (for local models like ALLaM / LLaMA)
# https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
